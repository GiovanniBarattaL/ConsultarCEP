<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9EC"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    tools:context=".MainActivity">


    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/numans"
        android:letterSpacing="0.02"
        android:text="Consulta CEP"
        android:textColor="#49BC6B"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/numans"
        android:text="Encontre um endereço pelo CEP"
        android:textColor="#7A756C"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textView" />


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:hint="CEP"
        app:boxBackgroundColor="#FFFFFF"
        app:boxCornerRadiusBottomEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp"
        app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusTopStart="14dp"
        app:boxStrokeColor="#E5A900"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:hintTextColor="#A57A00"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSubtitulo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/numans"
            android:hint=""
            android:inputType="number"
            android:maxLength="8"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:textColor="#282828"
            android:textColorHint="#AAA49A"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>


    <Button
        android:id="@+id/btnConsultar"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#49BC6B"
        android:elevation="4dp"
        android:fontFamily="@font/numans"
        android:text="CONSULTAR CEP"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textInputLayout" />


    <TextView
        android:id="@+id/txtResultadoTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/numans"
        android:text="Informações do endereço"
        android:textColor="#39362F"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnConsultar" />


    <TextView
        android:id="@+id/text1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/numans"
        android:text="Logradouro"
        android:textColor="#8A8276"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtResultadoTitulo" />

    <EditText
        android:id="@+id/txtLogradouro"
        android:layout_width="337dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D6CFC2"
        android:enabled="true"
        android:fontFamily="@font/numans"
        android:hint="Endereço"
        android:inputType="text"
        android:paddingStart="4dp"
        android:textColor="#33312C"
        android:textColorHint="#AAA49A"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text1" />

    <!-- BAIRRO -->

    <TextView
        android:id="@+id/text3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/numans"
        android:text="Bairro"
        android:textColor="#8A8276"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtLogradouro" />

    <EditText
        android:id="@+id/txtBairro"
        android:layout_width="337dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D6CFC2"
        android:enabled="true"
        android:fontFamily="@font/numans"
        android:hint="Bairro"
        android:inputType="text"
        android:paddingStart="4dp"
        android:textColor="#33312C"
        android:textColorHint="#AAA49A"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text3" />


    <TextView
        android:id="@+id/text4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/numans"
        android:text="UF"
        android:textColor="#8A8276"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtBairro" />

    <EditText
        android:id="@+id/txtUf"
        android:layout_width="337dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D6CFC2"
        android:enabled="true"
        android:fontFamily="@font/numans"
        android:hint="Estado"
        android:inputType="text"
        android:paddingStart="4dp"
        android:textColor="#33312C"
        android:textColorHint="#AAA49A"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text4" />

    <TextView
        android:id="@+id/text5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/numans"
        android:text="DDD"
        android:textColor="#8A8276"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtUf" />

    <EditText
        android:id="@+id/txtDdd"
        android:layout_width="337dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D6CFC2"
        android:enabled="true"
        android:fontFamily="@font/numans"
        android:hint="DDD"
        android:inputType="text"
        android:paddingStart="4dp"
        android:textColor="#33312C"
        android:textColorHint="#AAA49A"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text5" />

    <TextView
        android:id="@+id/text6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/numans"
        android:text="Cidade"
        android:textColor="#8A8276"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtDdd" />

    <EditText
        android:id="@+id/txtCidade"
        android:layout_width="337dp"
        android:layout_height="45dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="#D6CFC2"
        android:enabled="true"
        android:fontFamily="@font/numans"
        android:hint="Cidade"
        android:inputType="text"
        android:paddingStart="4dp"
        android:textColor="#33312C"
        android:textColorHint="#AAA49A"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text6" />


</androidx.constraintlayout.widget.ConstraintLayout>